# PostgreSQL connection used to store learner accounts.
DATABASE_URL="postgresql://user:password@localhost:5432/sankalp"

# Optional path to the PostgreSQL provider's trusted CA certificate (PEM).
# Needed only if its certificate authority is not trusted by Node.js by default.
# DATABASE_SSL_CA_FILE="C:\\certificates\\postgres-ca.pem"

# Create a unique 32+ character secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Administrator sign-in. Public registration can only create learner accounts.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Persistent directory for uploaded PDFs and images (15 MB per file).
UPLOAD_DIR="./uploads"
